DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# M-Pesa via PayHero — https://payhero.co.ke
PAYHERO_USERNAME=your_payhero_api_username
PAYHERO_PASSWORD=your_payhero_api_password
PAYHERO_CHANNEL_ID=your_payhero_channel_id
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
USD_TO_KES=130

# M-Pesa via GravityPay — https://gravitypayapp.com
# Switch default provider to GravityPay via Admin Control Center > Gateways tab, or set env:
GRAVITYPAY_API_KEY=your_gravitypay_api_key
GRAVITYPAY_SECRET_KEY=your_gravitypay_secret_key
GRAVITYPAY_WEBHOOK_SECRET=your_gravitypay_webhook_secret
GRAVITYPAY_CALLBACK_URL=https://yourdomain.com/api/payments/gravitypay/callback

# Crypto USDT TRC20 deposits
CRYPTO_USDT_ADDRESS=your_trc20_wallet_address
CRYPTO_AUTO_CONFIRM=false

# Real-Time Security Alerts via Telegram Bot
# Create bot with @BotFather and get chat ID with @userinfobot
TELEGRAM_BOT_TOKEN=7700000000:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ALERTS_ENABLED=true

# Security Secrets & Internal Keys
ADMIN_SECRET=generate-random-admin-secret-for-internal-services
