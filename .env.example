# ==============================================================================
# VERCEL ENVIRONMENT VARIABLES CONFIGURATION (.env)
# All sensitive gateway keys and telegram credentials must be configured here.
# Never hardcode or enter secret keys directly in the Admin Control Center.
# ==============================================================================

# Database & Authentication
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ------------------------------------------------------------------------------
# 1. M-PESA via GravityPay (Recommended) — https://gravitypayapp.com
# ------------------------------------------------------------------------------
GRAVITYPAY_API_KEY=your_gravitypay_api_key
GRAVITYPAY_SECRET_KEY=your_gravitypay_secret_key
GRAVITYPAY_WEBHOOK_SECRET=your_gravitypay_webhook_secret
GRAVITYPAY_CALLBACK_URL=https://yourdomain.com/api/payments/gravitypay/callback

# ------------------------------------------------------------------------------
# 2. M-PESA via PayHero — https://payhero.co.ke
# ------------------------------------------------------------------------------
PAYHERO_USERNAME=your_payhero_api_username
PAYHERO_PASSWORD=your_payhero_api_password
PAYHERO_CHANNEL_ID=your_payhero_channel_id
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback

# Default M-Pesa Provider: "gravitypay" or "payhero"
MPESA_PROVIDER=gravitypay

# Currency Conversion: 1 USD to KES exchange rate
USD_TO_KES=130

# ------------------------------------------------------------------------------
# 3. Crypto USDT (TRC20) Deposits
# ------------------------------------------------------------------------------
CRYPTO_USDT_ADDRESS=your_trc20_wallet_address
CRYPTO_AUTO_CONFIRM=false
TRONGRID_API_KEY=your_optional_trongrid_api_key

# ------------------------------------------------------------------------------
# 4. PayPal / Card Checkout (Orders v2 API)
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_client_id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_PAYEE_EMAIL=your_paypal_merchant_email
PAYPAL_ENV=live

# ------------------------------------------------------------------------------
# 5. Real-Time Security Alerts via Telegram Bot
# Create bot via @BotFather and retrieve chat ID via @userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=7700000000:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ALERTS_ENABLED=true

# ------------------------------------------------------------------------------
# 6. Security Secrets & Internal Services
# ------------------------------------------------------------------------------
ADMIN_SECRET=generate-random-admin-secret-for-internal-services
