# ── Database ──────────────────────────────────────────────
# Local (SQLite) — keep for dev:
# DATABASE_URL="file:./dev.db"
#
# Production (Neon PostgreSQL) — get from Neon Console:
# DATABASE_URL="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/smartdollarfx?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/smartdollarfx?sslmode=require"

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
# In Vercel, set NEXTAUTH_URL to your production domain

# ── M-Pesa via PayHero ──────────────────────────────────
PAYHERO_USERNAME=your_payhero_api_username
PAYHERO_PASSWORD=your_payhero_api_password
PAYHERO_CHANNEL_ID=your_payhero_channel_id
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
USD_TO_KES=130

# ── Crypto USDT TRC20 Deposits ──────────────────────────
CRYPTO_USDT_ADDRESS=your_trc20_wallet_address
CRYPTO_AUTO_CONFIRM=false

# ── Vercel / Next.js ─────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
